{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/groq.js": {
      "includeFiles": "ui/**"
    },
    "api/index.js": {
      "includeFiles": "ui/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/groq"
    },
    {
      "source": "/groq",
      "destination": "/api/groq"
    },
    {
      "source": "/groq/",
      "destination": "/api/groq"
    },
    {
      "source": "/chat",
      "destination": "/api/groq"
    },
    {
      "source": "/q",
      "destination": "/api/groq"
    },
    {
      "source": "/ask",
      "destination": "/api/groq"
    },
    {
      "source": "/ai",
      "destination": "/api/groq"
    },
    {
      "source": "/c",
      "destination": "/api/groq?format=bat"
    },
    {
      "source": "/j",
      "destination": "/api/groq?format=ps1"
    },
    {
      "source": "/groq.ps1",
      "destination": "/api/groq?format=ps1"
    }
  ]
}